# AITeam 环境配置示例（复制为 .env.dev / .env.test / .env.prod 后按需改密码）。
# 直接启动 Node Agent 也必须显式设置 AITEAM_ENV；scripts/ctl.sh 会按 --env 选择器注入它。
# 本文件由 scripts/ctl.sh 读取——启动器会自动构造 DB_URL / ADMIN_DB_URL /
# APP_RW_PASSWORD / OPERATOR_URL / MANAGER_URL 等连接串，无需在此手填。

# 变量分类标签：
#   [必需]  不设置则启动失败
#   [建议]  缺了跨端不通或功能降级
#   [ctl 自管] 由 ctl.sh 自动构造——不应再在 .env.* 列出
#   [可选]  代码有合理默认值

# ============================================================
# 服务端口（ctl.sh 用于启进程与 status 显示；应用本身不读）
# ============================================================
OPERATION_PORT=8781
MANAGER_PORT=8782
AGENT_PORT=8783
POSTGRES_PORT=5433  # 开发/测试 5433–5434；生产建议 5432
NEWAPI_PORT=9300     # 内部 Relay 管理/推理端口；默认只绑定 127.0.0.1

# ============================================================
# 数据库
# ============================================================
# [必需] ctl.sh 据此拼出 DB_URL / ADMIN_DB_URL / APP_RW_PASSWORD（见 ctl.sh load_env）
# 业务连接必须使用受 RLS 约束的 app_rw；superuser 仅用于迁移/DDL。
POSTGRES_USER=app_rw
POSTGRES_PASSWORD=app_rw_dev  # ⚠️ 生产必须修改
POSTGRES_DB=aiteam_v1          # 测试: aiteam_test；生产: aiteam_prod
POSTGRES_HOST=localhost
POSTGRES_SUPER_USER=aiteam
POSTGRES_SUPER_PASSWORD=aiteam_dev  # ⚠️ 生产必须修改
# POSTGRES_VOLUME=           # [ctl 自管] 缺省 aiteam_pg_data_<env>
# [ctl 自管] 以下 3 项由 ctl.sh 自动构造——不应在 .env.* 列出：
#   DB_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
#   ADMIN_DB_URL
#   APP_RW_PASSWORD

# ============================================================
# 运营端（Operation Service）
# ============================================================
# [必需] 不设置则运营端启动抛 ValueError
OPERATION_SYSTEM_USERNAME=sysadmin  # ⚠️ 生产必须修改
OPERATION_SYSTEM_PASSWORD=Dev-Pass-2024  # ⚠️ 生产必须使用强密码（最少 16 字符）
# [可选] 运营端 RSA 签名密钥（缺则启动时生成临时密钥，重启后旧 token 失效）
# 生产必须配置持久化密钥：
#   openssl genrsa -out operation-private.pem 2048
#   openssl rsa -in operation-private.pem -pubout -out operation-public.pem
# OPERATION_SIGNING_PRIVATE_KEY=
# OPERATION_SIGNING_PUBLIC_KEY=

# ============================================================
# 内部 NewAPI Relay（Operator 管理）
# ============================================================
NEWAPI_IMAGE=calciumion/new-api:v0.13.2
NEWAPI_DB_USER=newapi
NEWAPI_DB_PASSWORD=newapi_dev  # ⚠️ 生产必须修改
NEWAPI_DB_NAME=newapi
NEWAPI_REDIS_PASSWORD=newapi_dev  # ⚠️ 生产必须修改
NEWAPI_SESSION_SECRET=dev-newapi-session-secret-change-me  # 生产: openssl rand -hex 32
NEWAPI_CRYPTO_SECRET=dev-newapi-crypto-secret-change-me    # 生产: openssl rand -hex 32
NEWAPI_ADMIN_BASE_URL=http://127.0.0.1:9300
NEWAPI_PUBLIC_BASE_URL=http://127.0.0.1:9300/v1
# 首次 setup 后把 NewAPI 管理 access token 只配置给 Operation；禁止注入 Manager/Agent。
# NEWAPI_ADMIN_USER_ID=1
# NEWAPI_ADMIN_TOKEN=

# ============================================================
# 企业端（Manager Service）
# ============================================================
# [可选] 凭据加密密钥；缺则回退开发占位 key（仅 dev/测试，生产必须设置）
# 生成方式：openssl rand -base64 32
# MANAGER_CREDENTIAL_KEY=
# Manager-owned LightRAG query facade (API key stays in Manager only).
# LightRAG is a separately deployed Manager-side component; test and production use
# PostgreSQL + pgvector storage (PGKV/PGDocStatus/PGTableGraph/PGVector), not JSON files.
# Each LightRAG instance fixes one POSTGRES_WORKSPACE; Manager must route a knowledge
# space to its corresponding instance instead of trusting a client-supplied workspace.
# LIGHTRAG_URL=http://127.0.0.1:9621
# LIGHTRAG_API_KEY=
# Fixed workspace served by this LightRAG instance (must match Manager-derived handle).
# LIGHTRAG_WORKSPACE=
# LIGHTRAG_TIMEOUT_MS=5000
# Intake pipeline must be explicitly bounded; missing timeout fails closed.
# LIGHTRAG_PIPELINE_TIMEOUT_MS=120000
# LIGHTRAG_POLL_INTERVAL_MS=250
# Retrieval-only query mode; naive is robust before graph extraction is tuned, mix/hybrid later.
# LIGHTRAG_QUERY_MODE=naive
# Manager 知识源持久化根目录：本地启动不要设置，Settings 默认使用工作树 .data/manager；
# Docker Compose 在容器环境中显式设置为 /app/data，并挂载独立 managerdata 卷。
# Manager 签发 Agent 可验 JWT 的 issuer/audience（生产必须与 Agent 的 issuer/audience 完全一致）。
# AITEAM_JWT_ISSUER=https://manager.example.com
# AITEAM_JWT_AUDIENCE=aiteam-agent
# Manager-only Hindsight upstream. Agent never receives this service token.
# HINDSIGHT_URL=https://hindsight.example.com
# HINDSIGHT_SERVICE_TOKEN=
# HINDSIGHT_RECALL_PATH=/memories/recall
# HINDSIGHT_RETAIN_PATH=/memories/retain
# HINDSIGHT_DELETE_PATH=/memories/delete
# Optional public/root-relative Manager facade URL and opaque lease TTL (30..3600s).
# HINDSIGHT_FACADE_URL=/api/manager/hindsight
# HINDSIGHT_LEASE_TTL_SECONDS=300

# ============================================================
# 用户端（Agent Service）
# ============================================================
# Node Agent 本地数据目录（默认 ./.state/agent）
# AGENT_DATA_DIR=./.state/agent
# 本地开发可启用 Pi faux provider；生产必须关闭并配置 Pi 凭据。
# AITEAM_PI_FAKE=true
# 仅本地开发使用的 bearer 认证开关；生产必须使用 Manager JWKS 验证。
# AITEAM_AGENT_DEV_AUTH=true
# Agent→Manager 主动访问地址；生产必填。
# AITEAM_MANAGER_URL=http://127.0.0.1:8782
# Controlled Manager MCP endpoint; no ambient MCP discovery/configuration.
# AITEAM_RAG_MCP_URL=http://127.0.0.1:8782/api/manager/rag/mcp
# Agent Hindsight access is provisioned per employee by Manager at session start.
# Do not configure AITEAM_HINDSIGHT_URL, HINDSIGHT_API_TOKEN, or HINDSIGHT_API_KEY on Agent.
# A missing Manager lease fails closed when the employee memory policy is enabled.
# Dedicated Ed25519 PKCS8/SPKI Skill package signing (never reuse JWT/HMAC keys).
# Manager keeps private material only: current key signs while current+next public metadata overlap.
# AITEAM_SKILL_SIGNING_PRIVATE_KEY=<base64 DER PKCS8; Manager only/current>
# AITEAM_SKILL_SIGNING_KEY_ID=skills-2026-current
# AITEAM_SKILL_SIGNING_NEXT_PRIVATE_KEY=<base64 DER PKCS8; Manager only>
# AITEAM_SKILL_SIGNING_NEXT_KEY_ID=skills-2026-next
# Optional lifecycle metadata (RFC3339) and revoked key ids.
# AITEAM_SKILL_SIGNING_CURRENT_NOT_BEFORE=2026-01-01T00:00:00Z
# AITEAM_SKILL_SIGNING_CURRENT_EXPIRES_AT=2027-01-01T00:00:00Z
# AITEAM_SKILL_SIGNING_NEXT_NOT_BEFORE=2026-12-01T00:00:00Z
# AITEAM_SKILL_SIGNING_NEXT_EXPIRES_AT=2027-12-01T00:00:00Z
# AITEAM_SKILL_SIGNING_REVOKED_KEY_IDS=
# AITEAM_SKILL_SIGNING_REVOKED_KEYS_JSON='[]' # public metadata only
# Agent receives only public metadata; JSON may be an array or {"keys":[...]}.
# AITEAM_SKILL_SIGNING_PUBLIC_KEYS='[{"key_id":"skills-2026-current","public_key":"<base64 DER SPKI>","algorithm":"Ed25519","status":"current"},{"key_id":"skills-2026-next","public_key":"<base64 DER SPKI>","algorithm":"Ed25519","status":"next"}]'
# Legacy single-key bootstrap remains accepted during migration:
# AITEAM_SKILL_SIGNING_PUBLIC_KEY=<base64 DER SPKI; Agent only>
# AITEAM_SKILL_SIGNING_OFFLINE_TTL_SECONDS=86400
# 生产 JWT 验签配置（issuer/audience/JWKS 三者必须同时配置）。
# AITEAM_AGENT_JWKS_PATH=/etc/aiteam/agent/jwks.json
# AITEAM_AGENT_JWT_ISSUER=https://manager.example.com
# AITEAM_AGENT_JWT_AUDIENCE=aiteam-agent
# 外部 sandbox 已就绪才可允许 coding tools；生产还会在监听前执行真实 native probe。
# AITEAM_AGENT_SANDBOX_READY=false
# Node Agent SPA 根目录（Docker 默认 /app/web/agent/dist）。
# AITEAM_AGENT_SPA_ROOT=./web/agent/dist

# [ctl 自管] 三端监听 host 由 ctl.sh 按 ${HOST:-127.0.0.1} 自动取值——无需在此填写：
#   --host="${OPERATION_HOST:-127.0.0.1}"
#   --host="${MANAGER_HOST:-127.0.0.1}"
#   HOST="${AGENT_HOST:-127.0.0.1}" PORT="${AGENT_PORT}"
# 公网/物联网场景需要暴露时，仍建议改 ctl.sh 调用侧而非在此硬编码。

# ============================================================
# 跨端通信
# ============================================================
# [建议] 服务间认证 token；缺则 fail-open（dev 友好，但失去服务间鉴权）
# 生产必须使用强随机密钥：openssl rand -hex 32
SERVICE_TOKEN=dev-service-token-changeme
# 服务间 HTTP 超时（毫秒）；长事务/首次迁移不要使用过短值。
SERVICE_CLIENT_TIMEOUT_MS=30000

# [ctl 自管] Manager / Operation 服务地址——ctl.sh 已按 <host>:<port> 自动构造：
#   OPERATOR_URL="${OPERATOR_URL:-http://${OPERATOR_HOST:-127.0.0.1}:${OPERATION_PORT}}"
#   MANAGER_URL="${MANAGER_URL:-http://${MANAGER_HOST:-127.0.0.1}:${MANAGER_PORT}}"
# 仅当你从其它机器调本端时才在此显式覆盖：
# MANAGER_URL=http://localhost:8782
# OPERATOR_URL=http://localhost:8781

# ============================================================
# 通用
# ============================================================
# [ctl 自管] APP_TIER 由 ctl.sh --tier= 注入——不应在 .env.* 列出，否则三端共用同一 tier。
# [可选] 日志级别（默认 INFO；测试建议 DEBUG；生产 INFO / WARNING）
LOG_LEVEL=INFO
# [可选] 是否公开 /docs /redoc（默认 true；⚠️ 生产必须 false）
EXPOSE_PUBLIC_DOCS=true

# ============================================================
# 各环境差异速查（复制后按此修改即可）
# ============================================================
# 开发 (.env.dev)：
#   POSTGRES_PASSWORD=aiteam_dev    POSTGRES_DB=aiteam_v1
#   OPERATION_SYSTEM_USERNAME=sysadmin
#   OPERATION_SYSTEM_PASSWORD=Dev-Pass-2024
#   SERVICE_TOKEN=dev-service-token-changeme   LOG_LEVEL=INFO   EXPOSE_PUBLIC_DOCS=true
#
# 测试 (.env.test)：
#   POSTGRES_PORT=5434              POSTGRES_PASSWORD=aiteam_test
#   OPERATION_SYSTEM_USERNAME=sysadmin
#   OPERATION_SYSTEM_PASSWORD=Dev-Pass-2024
#   SERVICE_TOKEN=dev-service-token-changeme   LOG_LEVEL=INFO   EXPOSE_PUBLIC_DOCS=true
#   MANAGER_URL=http://127.0.0.1:8782         OPERATOR_URL=http://127.0.0.1:8781
#
# 生产 (.env.prod)：
#   POSTGRES_PORT=5432   POSTGRES_USER=aiteam_prod   POSTGRES_DB=aiteam_prod
#   POSTGRES_PASSWORD=<强随机>                      OPERATION_SYSTEM_USERNAME=<自定义>
#   OPERATION_SYSTEM_PASSWORD=<强密码≥16字符>
#   OPERATION_SIGNING_PRIVATE_KEY=<RSA 私钥>       OPERATION_SIGNING_PUBLIC_KEY=<RSA 公钥>
#   MANAGER_CREDENTIAL_KEY=<openssl rand -base64 32>
#   SERVICE_TOKEN=<openssl rand -hex 32>
#   AGENT_DATA_DIR=/var/lib/aiteam/agent         AITEAM_PI_FAKE=false
#   AITEAM_MANAGER_URL=https://manager.example.com AITEAM_AGENT_DEV_AUTH=false
#   AITEAM_AGENT_JWKS_PATH=/etc/aiteam/agent/jwks.json
#   AITEAM_AGENT_JWT_ISSUER=https://manager.example.com
#   AITEAM_AGENT_JWT_AUDIENCE=aiteam-agent
#   AITEAM_AGENT_SANDBOX_READY=true                AITEAM_AGENT_SPA_ROOT=/app/web/agent/dist
#   MANAGER_URL=https://manager.example.com        OPERATOR_URL=https://operation.example.com
#   LOG_LEVEL=INFO                                 EXPOSE_PUBLIC_DOCS=false
