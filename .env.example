# AITeam 环境配置示例
# 复制此文件为 .env.dev / .env.test / .env.prod 并根据环境修改

# ============================================================
# 服务端口配置
# ============================================================
OPERATION_PORT=8781
MANAGER_PORT=8782
AGENT_PORT=8783
POSTGRES_PORT=5433  # 开发/测试环境；生产环境建议 5432

# ============================================================
# 数据库配置
# ============================================================
POSTGRES_USER=aiteam
POSTGRES_PASSWORD=aiteam_dev  # ⚠️  生产环境必须修改
POSTGRES_DB=aiteam_v1  # 测试环境: aiteam_test; 生产环境: aiteam_prod
# PG16 Alpine 容器无 `postgres` 系统超管（taiyi 实测唯一 super = POSTGRES_USER）；
# 缺省 fallback 同 POSTGRES_USER，独立 manager_admin 角色留 PR TODO。
POSTGRES_HOST=localhost
# POSTGRES_SUPER_USER=
# POSTGRES_SUPER_PASSWORD=
# PG 数据卷名。缺省由 ctl.sh 注入 aiteam_pg_data_<env>（dev/test/prod 各用各卷，互不覆盖）；
# 想让某环境共用同一卷（或指向已有卷）时，在此显式指定，例如 POSTGRES_VOLUME=aiteam_pg_data
# POSTGRES_VOLUME=

# 应用层数据库连接（可选，由 ctl.sh 自动构造）
# DB_URL=postgresql://aiteam:aiteam_dev@localhost:5433/aiteam_v1
# ADMIN_DB_URL=postgresql://postgres:<pwd>@localhost:5433/aiteam_v1  # 独立 admin 填这里；缺省 fallback 见 ctl.sh
# APP_RW_PASSWORD=aiteam_dev

# ============================================================
# 运营端（Operation Service）配置
# ============================================================
# 运营端系统管理员账号（必需，无默认值）
OPERATION_SYSTEM_USERNAME=sysadmin  # 生产环境必须修改
OPERATION_SYSTEM_PASSWORD=Dev-Pass-2024  # ⚠️  生产环境必须使用强密码（最少16字符）

# 运营端 RSA 签名密钥（可选，未设置则启动时生成临时密钥）
# 生产环境必须配置持久化密钥，否则重启后旧 token 失效
# 生成方式：
#   openssl genrsa -out operation-private.pem 2048
#   openssl rsa -in operation-private.pem -pubout -out operation-public.pem
# 然后将密钥内容（包含 -----BEGIN/END----- 行）设置到环境变量
# OPERATION_SIGNING_PRIVATE_KEY=
# OPERATION_SIGNING_PUBLIC_KEY=

# ============================================================
# 企业端（Manager Service）配置
# ============================================================
# 企业端凭据加密密钥（可选，用于加密敏感配置）
# 生成方式：openssl rand -base64 32
# MANAGER_CREDENTIAL_KEY=

# ============================================================
# 用户端（Agent Service）配置
# ============================================================
# Agent 本地数据库路径（可选，未设置则使用内存数据库）
# 开发环境可留空；生产环境建议持久化
# AGENT_DB_PATH=./.state/agent.db

# Agent 运行时类型（可选，未设置则使用 Fake runtime）
# 可选值：fake | hermes | codex | claude_code | openclaw
# AGENT_RUNTIME=fake

# Agent 运行时工作目录根路径（可选）
# AGENT_RUNS_ROOT=./.state/runs

# Agent Loop 自动启动（可选，默认 false）
# AGENT_LOOP_AUTOSTART=false

# Agent Runtime 环境变量透传列表（逗号分隔，用于传递 API Key 等凭据）
# 沙箱默认脱敏所有环境变量，provider API Key 必须显式透传
# 示例：AGENT_RUNTIME_ENV_PASSTHROUGH=OPENAI_API_KEY,ANTHROPIC_API_KEY,NEWAPI_API_KEY
# AGENT_RUNTIME_ENV_PASSTHROUGH=

# 三端监听 host（缺省 127.0.0.1；公网/物联网场景填 0.0.0.0）
# MANAGER_HOST=0.0.0.0
# OPERATION_HOST=0.0.0.0
# AGENT_HOST=0.0.0.0

# ============================================================
# 跨端通信配置
# ============================================================
# 服务间认证 Token（可选，未设置则 fail-open 允许跨端调用）
# ⚠️  生产环境必须使用强随机密钥
# 生成方式：openssl rand -hex 32
SERVICE_TOKEN=dev-service-token-changeme

# Manager 服务地址（Agent 访问企业端时使用）
# MANAGER_URL=http://localhost:8782
# MANAGER_HOST=127.0.0.1

# Operation 服务地址（Manager 访问运营端时使用）
# OPERATOR_URL=http://localhost:8781
# OPERATOR_HOST=127.0.0.1

# ============================================================
# 通用配置
# ============================================================
# 应用层级（operation | manager | agent）
# 启动时通过 --tier 指定，无需在此设置
# APP_TIER=

# 日志级别（DEBUG | INFO | WARNING | ERROR）
# 开发环境: INFO; 测试环境: DEBUG; 生产环境: INFO 或 WARNING
LOG_LEVEL=INFO

# 公开 API 文档（true | false）
# ⚠️  生产环境必须设置为 false
EXPOSE_PUBLIC_DOCS=true

# ============================================================
# 不同环境的配置差异参考
# ============================================================
# 开发环境 (.env.dev)：
#   POSTGRES_PASSWORD=aiteam_dev
#   POSTGRES_DB=aiteam_v1
#   OPERATION_SYSTEM_USERNAME=sysadmin
#   OPERATION_SYSTEM_PASSWORD=Dev-Pass-2024
#   SERVICE_TOKEN=dev-service-token-changeme
#   LOG_LEVEL=INFO
#   EXPOSE_PUBLIC_DOCS=true
#
# 测试环境 (.env.test)：
#   POSTGRES_PASSWORD=aiteam_test
#   POSTGRES_DB=aiteam_test
#   OPERATION_SYSTEM_USERNAME=test-admin
#   OPERATION_SYSTEM_PASSWORD=Test-Pass-2024
#   SERVICE_TOKEN=test-service-token-changeme
#   LOG_LEVEL=DEBUG
#   EXPOSE_PUBLIC_DOCS=true
#
# 生产环境 (.env.prod)：
#   POSTGRES_PORT=5432
#   POSTGRES_USER=aiteam_prod
#   POSTGRES_PASSWORD=<强随机密码>
#   POSTGRES_DB=aiteam_prod
#   OPERATION_SYSTEM_USERNAME=<自定义用户名>
#   OPERATION_SYSTEM_PASSWORD=<强密码，最少16字符>
#   OPERATION_SIGNING_PRIVATE_KEY=<RSA私钥>
#   OPERATION_SIGNING_PUBLIC_KEY=<RSA公钥>
#   SERVICE_TOKEN=<openssl rand -hex 32>
#   LOG_LEVEL=INFO
#   EXPOSE_PUBLIC_DOCS=false
