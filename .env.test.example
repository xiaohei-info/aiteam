# AITeam 测试环境配置
# 可版本化（改密码即可复用于其他测试环境）。
# 本文件由 scripts/ctl.sh 读取——启动器会自动构造 DB_URL / ADMIN_DB_URL /
# APP_RW_PASSWORD / OPERATOR_URL / MANAGER_URL 等连接串，无需在此手填。

# ============================================================
# 服务端口（ctl.sh 用于启进程与 status 显示；应用本身不读）
# ============================================================
OPERATION_PORT=8781
MANAGER_PORT=8782
AGENT_PORT=8783
POSTGRES_PORT=5434
NEWAPI_PORT=9300

# ============================================================
# 服务监听地址（ctl.sh 透传给 uvicorn --host）
# ============================================================
# 测试环境对外暴露时需设为 0.0.0.0；缺省回退到 127.0.0.1（仅本机可访问）。
OPERATION_HOST=0.0.0.0
MANAGER_HOST=0.0.0.0
AGENT_HOST=0.0.0.0

# ============================================================
# 数据库
# ============================================================
# [必需] ctl.sh 据此拼出 DB_URL / ADMIN_DB_URL / APP_RW_PASSWORD
# 业务连接必须使用受 RLS 约束的 app_rw；superuser 只用于迁移/DDL。
POSTGRES_USER=app_rw
POSTGRES_PASSWORD=app_rw_test
POSTGRES_SUPER_USER=aiteam
POSTGRES_SUPER_PASSWORD=aiteam_test
POSTGRES_DB=aiteam_v1
# [ctl 自管] DB_URL / ADMIN_DB_URL / APP_RW_PASSWORD 由 ctl.sh 自动构造，不再列出

# ============================================================
# 运营端
# ============================================================
# [必需] 不设置则运营端启动抛 ValueError
OPERATION_SYSTEM_USERNAME=sysadmin
OPERATION_SYSTEM_PASSWORD=Dev-Pass-2024
# [可选] 运营端 RSA 签名密钥；缺则启动时生成临时密钥
# OPERATION_SIGNING_PRIVATE_KEY=
# OPERATION_SIGNING_PUBLIC_KEY=

# ============================================================
# 内部 NewAPI Relay（Operator 管理；Manager/Agent 不得获得管理凭据）
# ============================================================
NEWAPI_IMAGE=calciumion/new-api:v0.13.2
NEWAPI_DB_USER=newapi
NEWAPI_DB_PASSWORD=change-newapi-db-password
NEWAPI_DB_NAME=newapi
NEWAPI_REDIS_PASSWORD=change-newapi-redis-password
NEWAPI_SESSION_SECRET=change-with-openssl-rand-hex-32
NEWAPI_CRYPTO_SECRET=change-with-openssl-rand-hex-32
NEWAPI_ADMIN_BASE_URL=http://127.0.0.1:9300
NEWAPI_PUBLIC_BASE_URL=http://127.0.0.1:9300/v1
# 首次 bootstrap 后配置给 Operator；不得注入 Manager/Agent。
# NEWAPI_ADMIN_USER_ID=1
# NEWAPI_ADMIN_TOKEN=

# ============================================================
# 企业端
# ============================================================
# [可选] 凭据加密密钥；缺则回退开发占位 key
# MANAGER_CREDENTIAL_KEY=
# 测试可覆盖 Manager 知识源根目录；未设置时 Settings 使用工作树 .data/manager
# AITEAM_MANAGER_DATA_ROOT=
# Manager-only Hindsight upstream for the facade lease tests; never copy the token to Agent.
# HINDSIGHT_URL=http://127.0.0.1:8791
# HINDSIGHT_SERVICE_TOKEN=
# HINDSIGHT_RECALL_PATH=/memories/recall
# HINDSIGHT_RETAIN_PATH=/memories/retain
# HINDSIGHT_DELETE_PATH=/memories/delete
# HINDSIGHT_FACADE_URL=/api/manager/hindsight
# HINDSIGHT_LEASE_TTL_SECONDS=300

# ============================================================
# 用户端
# ============================================================
# Node Agent 本地数据目录与本地开发开关
AGENT_DATA_DIR=./.state/agent
AITEAM_AGENT_DEV_AUTH=true
AITEAM_PI_FAKE=true

# ============================================================
# 跨端通信
# ============================================================
# 测试环境集成了三端联调，建议显式配置跨端地址。
SERVICE_TOKEN=dev-service-token-changeme
MANAGER_URL=http://127.0.0.1:8782
OPERATOR_URL=http://127.0.0.1:8781

# ============================================================
# 通用
# ============================================================
LOG_LEVEL=INFO
EXPOSE_PUBLIC_DOCS=true
