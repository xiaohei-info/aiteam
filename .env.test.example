# AITeam v1 测试环境配置（可版本化；改密码即可复用于其他测试环境）

# ========= 服务端口（对齐 scripts/ctl.sh 默认值） =========
OPERATION_PORT=8781
MANAGER_PORT=8782
AGENT_PORT=8783
POSTGRES_PORT=5434
POSTGRES_HOST=localhost

# ========= 数据库 =========
# PG16 Alpine：唯一超级角色 = aiteam，无 postgres 系统超管。
POSTGRES_USER=aiteam
POSTGRES_PASSWORD=aiteam_test
POSTGRES_DB=aiteam_v1
# POSTGRES_SUPER_USER=       # 缺省 fallback 到 POSTGRES_USER
# POSTGRES_SUPER_PASSWORD=   # 缺省 fallback 到 POSTGRES_PASSWORD

# 应用层连接串（注释 = 由 scripts/ctl.sh load_env 自动构造）
# DB_URL=postgresql://aiteam:aiteam_test@localhost:5434/aiteam_v1
# ADMIN_DB_URL=postgresql://aiteam:aiteam_test@localhost:5434/aiteam_v1

# ========= 运营端系统管理员（进程内存预置，不走 DB） =========
OPERATION_SYSTEM_USERNAME=sysadmin
OPERATION_SYSTEM_PASSWORD=Dev-Pass-2024
# OPERATION_SIGNING_PRIVATE_KEY=
# OPERATION_SIGNING_PUBLIC_KEY=

# ========= 企业端（Manager） =========
# MANAGER_CREDENTIAL_KEY=   # openssl rand -base64 32

# ========= 用户端（Agent） =========
# AGENT_DB_PATH=            # 缺省 .state/agent.sqlite
# AGENT_RUNTIME=            # 缺省 fake（fake | hermes | codex | claude_code | openclaw）
# AGENT_RUNS_ROOT=          # 缺省 .state/runs
# AGENT_LOOP_AUTOSTART=     # 缺省 false
# AGENT_RUNTIME_ENV_PASSTHROUGH=   # 例：OPENAI_API_KEY,ANTHROPIC_API_KEY

# ========= 跨端通信 =========
SERVICE_TOKEN=dev-service-token-changeme
MANAGER_URL=http://127.0.0.1:8782
OPERATOR_URL=http://127.0.0.1:8781

# 三端监听公网 host（测试/物联网填 0.0.0.0）
# MANAGER_HOST=0.0.0.0
# OPERATION_HOST=0.0.0.0
# AGENT_HOST=0.0.0.0

# ========= 通用 =========
LOG_LEVEL=INFO
EXPOSE_PUBLIC_DOCS=true

# ========= 非目标 =========
# tenant + owner 预置不在此文件，走 UI 业务流：
#   1. sysadmin 登录 Operation UI → 开通企业（POST /api/operation/enterprises）
#   2. 拿到 tenant_id + 初始密码
#   3. 用 tenant_id + 账号登录 Agent UI
