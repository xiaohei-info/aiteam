# AITeam 测试环境配置模板
# 复制此文件为 .env.test 并根据需要修改

# 服务端口
OPERATION_PORT=8781
MANAGER_PORT=8782
AGENT_PORT=8783
POSTGRES_PORT=5433

# 数据库配置
POSTGRES_USER=aiteam
POSTGRES_PASSWORD=aiteam_test_env
POSTGRES_DB=aiteam_test

# 服务间认证（测试环境应使用不同的密钥）
SERVICE_TOKEN=test-service-token-placeholder

# 日志级别
LOG_LEVEL=DEBUG

# 公开文档（测试环境）
EXPOSE_PUBLIC_DOCS=1
