{
  "name": "@aiteam/shared",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AI Team v1 前端共享包：业务契约、API 基类、时间线、角色状态、i18n、页面壳模型、应用基础设施与 Astryx 主题。",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "import": "./dist/contracts/index.js"
    },
    "./api-client": {
      "types": "./dist/api-client/index.d.ts",
      "import": "./dist/api-client/index.js"
    },
    "./role-state": {
      "types": "./dist/role-state/index.d.ts",
      "import": "./dist/role-state/index.js"
    },
    "./i18n": {
      "types": "./dist/i18n/index.d.ts",
      "import": "./dist/i18n/index.js"
    },
    "./page-shell": {
      "types": "./dist/page-shell/index.d.ts",
      "import": "./dist/page-shell/index.js"
    },
    "./app-kit": {
      "types": "./dist/app-kit/index.d.ts",
      "import": "./dist/app-kit/index.js"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "import": "./dist/theme/index.js"
    }
  },
  "scripts": {
    "build": "node -e \"const{rmSync}=require('node:fs');for(const p of ['dist/ui','dist/design-system'])rmSync(p,{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@stylexjs/stylex": "0.18.3",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^2.1.9",
    "jsdom": "^25.0.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "@stylexjs/stylex": "0.18.3",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  },
  "dependencies": {
    "@astryxdesign/core": "0.1.4",
    "@astryxdesign/theme-stone": "0.1.4",
    "@tanstack/react-query": "^5.101.0"
  }
}
