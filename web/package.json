{
  "name": "@aiteam/web",
  "version": "1.0.0",
  "private": true,
  "description": "AI Team v1 前端单仓工作区（运营端 / 企业端 / 用户端 + 共享包）。",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "coverage": "pnpm -r exec vitest run --coverage",
    "coverage:diff": "bash scripts/coverage-diff.sh",
    "e2e": "pnpm --filter @aiteam/shared run build && playwright test"
  },
  "packageManager": "pnpm@11.4.0",
  "devDependencies": {
    "@astryxdesign/cli": "0.1.4",
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "^1.61.1"
  },
  "pnpm": {
    "overrides": {
      "react": "19.2.7",
      "react-dom": "19.2.7",
      "@types/react": "19.2.17",
      "@types/react-dom": "19.2.3"
    }
  }
}
