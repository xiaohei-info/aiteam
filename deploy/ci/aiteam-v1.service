[Unit]
Description=aiteam v1 three-tier (operation/manager/agent)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/app/aiteam
ExecStart=/usr/bin/env bash /root/app/aiteam/scripts/ctl.sh start --env test --daemon
ExecStop=/usr/bin/env bash /root/app/aiteam/scripts/ctl.sh stop --env test
ExecReload=/usr/bin/env bash /root/app/aiteam/scripts/ctl.sh restart --env test --daemon
Environment=PATH=/root/app/aiteam/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Restart=on-failure
RestartSec=5
SyslogIdentifier=aiteam-v1

# no per-service sandbox: ctl.sh manages three tiers that write to
# logs/ under the same directory, so ProtectSystem=strict would block
# the python's log writes. The services are unprivileged network
# tenants at best; system-level sandboxing is a future hardening step.
PrivateTmp=true

[Install]
WantedBy=multi-user.target
