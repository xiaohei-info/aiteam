[Unit]
Description=aiteam v1 control planes + Node Agent (operation/manager/agent)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=@DEPLOY_ROOT@
ExecStart=/usr/bin/env bash @DEPLOY_ROOT@/scripts/ctl.sh start --env @ENV_TARGET@ --daemon
ExecStop=/usr/bin/env bash @DEPLOY_ROOT@/scripts/ctl.sh stop --env @ENV_TARGET@
ExecReload=/usr/bin/env bash @DEPLOY_ROOT@/scripts/ctl.sh restart --env @ENV_TARGET@ --daemon
Environment=PATH=@DEPLOY_ROOT@/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Restart=on-failure
RestartSec=5
SyslogIdentifier=aiteam-v1

# no per-service sandbox: ctl.sh manages three tiers that write to
# logs/ under the same directory, so ProtectSystem=strict would block
# service log writes. The services are unprivileged network
# tenants at best; system-level sandboxing is a future hardening step.
PrivateTmp=true

[Install]
WantedBy=multi-user.target
