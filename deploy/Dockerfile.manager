# 企业端构建产物（D15 / 09 §14.2）。
# 按端精简：只装 server/{manager_service,shared} + server/run.py + server/requirements.txt，
#           前端只装 web/manager 构建产物。
# 红线：绝不打包 server/agent_service、server/operation_service、web/agent、web/operation。

# ---------------------------------------------------------------------------
# Stage 1: 前端构建（node 构建 web/manager + web/shared → dist）
# ---------------------------------------------------------------------------
FROM node:22-alpine AS web-builder
WORKDIR /build

COPY web/package.json web/pnpm-workspace.yaml web/pnpm-lock.yaml ./
COPY web/shared/package.json web/shared/
COPY web/manager/package.json web/manager/

RUN corepack enable && corepack prepare pnpm@11.4.0 --activate \
    && pnpm install --frozen-lockfile --filter @aiteam/manager-web... --filter @aiteam/shared

COPY web/shared/ web/shared/
COPY web/manager/ web/manager/

RUN pnpm --filter @aiteam/shared build && pnpm --filter @aiteam/manager-web build

# ---------------------------------------------------------------------------
# Stage 2: 后端运行时（python slim）
# ---------------------------------------------------------------------------
FROM python:3.12-slim AS runtime

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY server/requirements.txt /app/server/requirements.txt
RUN pip install --no-cache-dir -r /app/server/requirements.txt

# 仅 COPY 本端后端代码 + shared + 统一启动器（严格限定，绝不 COPY agent_service/operation_service）。
COPY server/run.py /app/server/run.py
COPY server/shared/ /app/server/shared/
COPY server/manager_service/ /app/server/manager_service/

COPY --from=web-builder /build/web/manager/dist /app/web/manager/dist

ENV PYTHONPATH=/app/server \
    APP_TIER=manager

EXPOSE 8000

ENTRYPOINT ["python", "server/run.py", "--tier=manager", "--host", "0.0.0.0", "--port", "8000"]
