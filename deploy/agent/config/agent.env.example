# AI Team Agent sidecar configuration.
# This file is data, not a shell script: do not use ${...} expansion.
# Keep it portable: the launcher supplies DATA_DIR, SPA_ROOT and PORT_FILE.

AITEAM_ENV=production
AITEAM_AGENT_LOCAL_ONLY=true
AITEAM_AGENT_SANDBOX_READY=true
HOST=127.0.0.1
PORT=8180

# Manager may serve multiple enterprises; this Agent binds to one Manager origin per session. Do not use an internal Docker address.
AITEAM_MANAGER_URL=https://manager.example.com
# Must byte-for-byte equal Manager's configured AITEAM_JWT_ISSUER and AITEAM_MANAGER_URL in production; do not add/remove a trailing slash.
# This URL is an example, not an issuer discovered from AITEAM_MANAGER_URL.
AITEAM_AGENT_JWT_ISSUER=https://manager.example.com
# Must match a value in Manager-issued JWT aud (Manager AITEAM_JWT_AUDIENCE).
AITEAM_AGENT_JWT_AUDIENCE=aiteam-agent
# Public RSA RS256 JWKS only, loaded at startup. Configure exactly one of inline JSON or path.
AITEAM_AGENT_JWKS_JSON=
# A relative path resolves beside the selected agent.env, NOT the executable/cwd.
# Copy config/manager-jwks.json alongside agent.env when installing/upgrading.
# AITEAM_AGENT_JWKS_PATH=manager-jwks.json
# Controlled rotation: distribute trusted current+next public keys, then restart Agent.
# No automatic JWKS download, issuer discovery, hot reload, or private/signing keys.

# Optional Manager-owned enterprise RAG MCP endpoint; same origin as Manager.
# No direct LightRAG URL, workspace, token, or embedded URL credentials.
# AITEAM_RAG_MCP_URL=https://manager.example.com/api/manager/rag/mcp

# Public Ed25519 key metadata used to verify Manager-authorized Skill packages.
# AITEAM_SKILL_SIGNING_PUBLIC_KEY is the base64 SPKI key; never put a private key here.
AITEAM_SKILL_SIGNING_PUBLIC_KEY=
AITEAM_SKILL_SIGNING_KEY_ID=

# Exact origins of the embedding desktop client, comma-separated (use `null`
# for a file:// WebView). Keep empty when the client proxies requests through
# the Agent origin.
AITEAM_AGENT_ALLOWED_ORIGINS=

# Provider/API keys, Hindsight/LightRAG credentials, service tokens and private
# keys are never package configuration. Agent receives authorized short-lived
# runtime material from Manager in memory.
