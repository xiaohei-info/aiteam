# 用户端 Agent 独立 Node 产物（D15）：不打包 Python 控制面或旧 Agent 实现。

FROM node:22-alpine AS web-builder
WORKDIR /build

COPY web/package.json web/pnpm-workspace.yaml web/pnpm-lock.yaml web/tsconfig.base.json ./
COPY web/shared/package.json shared/
COPY web/agent/package.json agent/
RUN corepack enable && corepack prepare pnpm@11.4.0 --activate \
    && pnpm install --frozen-lockfile --filter @aiteam/agent... --filter @aiteam/shared
COPY web/shared/ shared/
COPY web/agent/ agent/
RUN pnpm --filter @aiteam/shared build && pnpm --filter @aiteam/agent build

FROM node:22-alpine AS runtime
WORKDIR /app/server/agent_service

# bwrap is the preferred Linux runner; Landlock remains the provider fallback.
# If neither runner is functionally usable, production startup fails closed.
RUN apk add --no-cache bubblewrap

COPY server/agent_service/package.json server/agent_service/pnpm-lock.yaml server/agent_service/pnpm-workspace.yaml ./
RUN corepack enable && corepack prepare pnpm@11.4.0 --activate \
    && pnpm install --frozen-lockfile --prod=false
COPY server/agent_service/src/ ./src/
COPY --from=web-builder /build/agent/dist /app/web/agent/dist

ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=8000 \
    AITEAM_AGENT_DATA_DIR=/app/data \
    AITEAM_AGENT_SANDBOX_READY=false

EXPOSE 8000
ENTRYPOINT ["pnpm", "start"]
