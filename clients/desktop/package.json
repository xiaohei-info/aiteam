{
  "name": "ai-team-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "agent:build": "node scripts/build-agent.mjs",
    "agent:check": "node scripts/check-agent.mjs",
    "agent:configure": "node scripts/configure-agent-package.mjs",
    "agent:configure:test": "node scripts/configure-agent-test.mjs",
    "agent:import": "node scripts/import-agent.mjs",
    "agent:test": "node --test scripts/test-agent-client.mjs",
    "build": "tsc -b && vite build",
    "check:agent-package": "node scripts/check-agent-package.mjs",
    "check:api-contract": "node --experimental-strip-types scripts/check-api-contract.mjs",
    "check:api-url-security": "node --experimental-strip-types --test tests/apiUrlSecurity.test.ts",
    "check:dependencies": "node scripts/check-dependency-audit.mjs",
    "check:secure-auth": "node scripts/check-secure-auth-storage.mjs",
    "check:security": "pnpm check:sensitive-logs && pnpm check:api-url-security && pnpm check:secure-auth && pnpm check:tauri-security && pnpm check:dependencies",
    "check:sensitive-logs": "node --experimental-strip-types scripts/check-sensitive-request-logs.mjs",
    "check:service-clients": "node scripts/check-service-clients.mjs",
    "check:tauri-security": "node scripts/check-tauri-security.mjs",
    "check:tauri-versions": "node scripts/check-tauri-versions.mjs",
    "dev": "vite",
    "dev:prod": "node scripts/dev-env.mjs prod",
    "dev:status": "node scripts/dev-env.mjs status",
    "dev:stop": "node scripts/dev-env.mjs stop",
    "dev:test": "node scripts/dev-env.mjs test",
    "lint": "eslint . --max-warnings 18",
    "office:preview": "node scripts/build-office-map-preview.mjs && python3 -m http.server 4180 --directory public",
    "office:preview:build": "node scripts/build-office-map-preview.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:build": "tauri build",
    "tauri:build:agent": "tauri build --config src-tauri/tauri.agent.conf.json",
    "tauri:build:mac:arm64": "tauri build --target aarch64-apple-darwin --bundles dmg",
    "tauri:build:mac:installer": "bash scripts/build-macos-installer.sh",
    "tauri:build:mac:intel": "tauri build --target x86_64-apple-darwin --bundles dmg",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@esotericsoftware/spine-pixi-v8": "~4.2.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-http": "~2.5.9",
    "@tauri-apps/plugin-notification": "^2.8.0",
    "@tauri-apps/plugin-store": "^2.5.0",
    "lucide-react": "^1.17.0",
    "pixi.js": "^8.18.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-image": "^4.1.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.28.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.4",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "office-map-edit-tool": "link:../office-map-edit-tool",
    "postcss": "^8.5.18",
    "react-test-renderer": "18.3.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.69.0",
    "vite": "^6.4.4"
  }
}
