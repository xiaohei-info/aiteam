# Production profile for `pnpm dev:prod` (and `pnpm agent:configure`).
# Copy to config/agent/production.env and replace every example value with what the
# deployment owner supplies. Public material only: never put passwords, tokens, private
# keys or provider credentials here. `pnpm dev:prod` refuses example.com placeholders.
AITEAM_ENV=production
AITEAM_AGENT_DEV_AUTH=false
AITEAM_PI_FAKE=false
AITEAM_AGENT_LOCAL_ONLY=true
AITEAM_AGENT_SANDBOX_READY=true
HOST=127.0.0.1
PORT=0

# Manager HTTPS origin. The issuer must equal it byte for byte (no added or removed trailing slash).
AITEAM_MANAGER_URL=https://manager.example.com
AITEAM_AGENT_JWT_ISSUER=https://manager.example.com
AITEAM_AGENT_JWT_AUDIENCE=aiteam-agent
# Optional Manager RAG MCP endpoint (same origin as Manager).
# AITEAM_RAG_MCP_URL=https://manager.example.com/api/manager/rag/mcp

# Desktop gateway mode: bare HTTPS origin of the Agent that executes conversations.
AITEAM_AGENT_UPSTREAM_URL=https://agent.example.com
AITEAM_AGENT_ALLOWED_ORIGINS=

# Public RS256 JWKS (kty/alg/kid/n/e/use only), a path relative to this file.
AITEAM_AGENT_JWKS_PATH=production-jwks.json

# Public Ed25519 key (base64 SPKI) and its id, used to verify Manager-authorized Skill packages.
AITEAM_SKILL_SIGNING_PUBLIC_KEY=
AITEAM_SKILL_SIGNING_KEY_ID=
