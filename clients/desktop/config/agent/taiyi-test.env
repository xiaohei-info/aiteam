# The single environment configuration (taiyi TEST, docs/design/new_design.md), shared by
# `pnpm tauri dev` and packaged builds: `pnpm agent:build` / `pnpm agent:import` bake this file into the
# bundled Agent (scripts/configure-agent-package.mjs). Matches FredServer/.env.test.example
# and scripts/ctl.sh test mode.
# Sessions run in this local Agent, which talks to Manager itself (the desktop gateway mode was
# dropped). Real JWT verification: AITEAM_AGENT_JWKS_MODE=manager fetches each tenant's public
# keys from the fixed AITEAM_MANAGER_URL origin, the same way the TEST server Agent does, so no
# public key ships in the package. Development auth (AITEAM_AGENT_DEV_AUTH=true) must not be used.
AITEAM_ENV=test
AITEAM_AGENT_DEV_AUTH=false
AITEAM_PI_FAKE=false
AITEAM_AGENT_LOCAL_ONLY=true
AITEAM_AGENT_SANDBOX_READY=true
HOST=127.0.0.1
PORT=0
AITEAM_MANAGER_URL=http://121.40.78.201:8782
AITEAM_RAG_MCP_URL=http://121.40.78.201:8782/api/manager/rag/mcp
AITEAM_AGENT_ALLOWED_ORIGINS=
AITEAM_AGENT_JWKS_MODE=manager
AITEAM_AGENT_JWT_ISSUER=aiteam-manager
AITEAM_AGENT_JWT_AUDIENCE=aiteam-agent
